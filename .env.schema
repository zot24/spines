# @defaultRequired=false @defaultSensitive=false
# Spines keeps no passwords. The bind address is the trust boundary.

# Host folder for the catalog, generated spines, and cover cache.
# This is the folder to back up or move. Nothing important lives only in the container.
# @required
# @type=string
SPINES_DATA=/data

# Listen address.
# @type=string
SPINES_BIND=0.0.0.0:8787

# Read-only mount a chosen music folder must stay inside. Defaults to SPINES_MUSIC.
# @type=string
SPINES_MEDIA=

# Folder offered on the first-open screen. Scanned only after it is saved in the data folder.
# @type=string
SPINES_MUSIC=

# Calibre library folder, or the parent of the one folder that holds metadata.db.
# Empty disables the books shelf. The file is opened read-only.
# @type=string
SPINES_BOOKS=

# Optional numeric ids for the container user. Used by docker compose, not by the binary.
# @type=string
SPINES_UID=1000
# @type=string
SPINES_GID=1000

# Set to 1 or true to read every file on the next start, even when the stamp matches.
# @type=string
SPINES_FORCE_RESCAN=

# Host paths for docker-compose.example.yml. Not read by the binary.
# @type=string
SPINES_DATA_DIR=
# @type=string
SPINES_MUSIC_DIR=
# @type=string
SPINES_BOOKS_DIR=
